# AskKB 开发环境配置
ENVIRONMENT=dev
DEBUG=true
HOST=0.0.0.0
PORT=8000

# 数据库（本地 MySQL 127.0.0.1:13306 root:root；异步驱动 aiomysql）
# 首次使用需先建库： CREATE DATABASE askkb DEFAULT CHARSET utf8mb4 COLLATE utf8mb4_unicode_ci;
# DATABASE_URL=sqlite+aiosqlite:///./data/askkb.db
DATABASE_URL=mysql+aiomysql://root:root@127.0.0.1:13306/askkb?charset=utf8mb4

# DashScope API Key（从系统环境变量 DASHSCOPE_API_KEY 或 DASH_SCOPE_API_KEY 继承，此处可覆盖）
# DASHSCOPE_API_KEY=sk-xxxxx

# 向量库（开发用 Chroma）
VECTOR_STORE_TYPE=chroma
CHROMA_PERSIST_DIR=./data/chroma_db

# CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Redis（本地 6379；会话记忆 db0，Celery broker db1 / result db2；不可用时后端自动降级为内存）
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2