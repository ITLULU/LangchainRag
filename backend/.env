# AskKB 开发环境配置
ENVIRONMENT=dev
DEBUG=true
HOST=0.0.0.0
PORT=8000

# 数据库（开发用 SQLite）
DATABASE_URL=sqlite+aiosqlite:///./data/askkb.db

# DashScope API Key（从系统环境变量 DASHSCOPE_API_KEY 或 DASH_SCOPE_API_KEY 继承，此处可覆盖）
# DASHSCOPE_API_KEY=sk-xxxxx

# 向量库（开发用 Chroma）
VECTOR_STORE_TYPE=chroma
CHROMA_PERSIST_DIR=./data/chroma_db

# CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Redis（开发可选，不可用时自动降级为内存）
REDIS_URL=redis://localhost:6379/0